<mxfile host="app.diagrams.net"><diagram name="Referensdata"><mxGraphModel dx="1900" dy="1535" grid="0" page="1" pageWidth="1900" pageHeight="1535" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B8C4D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1860" height="170" as="geometry"/></mxCell><mxCell id="lanel0" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#B8C4D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="130" height="170" as="geometry"/></mxCell><mxCell id="lanet0" value="&lt;b&gt;Användare&lt;/b&gt;&lt;br&gt;Sparar och rättar Excel-filer i SharePoint" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F3A57;spacing=2;" vertex="1" parent="1"><mxGeometry x="24" y="78" width="122" height="154" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C4D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1860" height="170" as="geometry"/></mxCell><mxCell id="lanel1" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#B8C4D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="130" height="170" as="geometry"/></mxCell><mxCell id="lanet1" value="&lt;b&gt;Utlösare och notiser&lt;/b&gt;&lt;br&gt;Logic Apps, en per bibliotek eller mapp" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F3A57;spacing=2;" vertex="1" parent="1"><mxGeometry x="24" y="258" width="122" height="154" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B8C4D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1860" height="170" as="geometry"/></mxC