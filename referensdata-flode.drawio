ent="1"><mxGeometry x="24" y="798" width="122" height="154" as="geometry"/></mxCell><mxCell id="lane5" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C4D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="970" width="1860" height="170" as="geometry"/></mxCell><mxCell id="lanel5" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF6;strokeColor=#B8C4D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="970" width="130" height="170" as="geometry"/></mxCell><mxCell id="lanet5" value="&lt;b&gt;Produktion&lt;/b&gt;&lt;br&gt;Azure-subscription för produktion" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F3A57;spacing=2;" vertex="1" parent="1"><mxGeometry x="24" y="978" width="122" height="154" as="geometry"/></mxCell><mxCell id="s1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="170" y="85" width="200" height="140" as="geometry"/></mxCell><mxCell id="s1_i" value="S" style="ellipse;whiteSpace=wrap;html=1;fillColor=#038387;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="95" width="30" height="30" as="geometry"/></mxCell><mxCell id="s1_t" value="&lt;b&gt;Användaren sparar en fil&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="218" y="93" width="146" height="34" as="geometry"/></mxCell><mxCell id="s1_b" value="En referensdatafil ändras i ett SharePoint-bibliotek. Det kan vara hundratals filer, så triggern sätts per bibliotek eller mapp och inte per fil." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="178" y="131" width="184" height="90" as="geometry"/></mxCell><mxCell id="s1_n" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="164" y="79" width="22" height="22" as="geometry"/></mxCell><mxCell id="u" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="650" y="85" width="200" height="140" as="geometry"/></mxCell><mxCell id="u_i" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="95" width="30" height="30" as="geometry"/></mxCell><mxCell id="u_t" value="&lt;b&gt;Användaren rättar felet&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="698" y="93" width="146" height="34" as="geometry"/></mxCell><mxCell id="u_b" value="Användaren ser vilket krav som bröts, rättar filen och sparar en ny version. Då startar flödet om från steg 1." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="658" y="131" width="184" height="90" as="geometry"/></mxCell><mxCell id="s2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FC;strokeColor=#0078D4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="410" y="265" width="200" height="140" as="geometry"/></mxCell><mxCell id="s2_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/integration/Logic_Apps.svg;" vertex="1" parent="1"><mxGeometry x="420" y="275" width="30" height="30" as="geometry"/></mxCell><mxCell id="s2_t" value="&lt;b&gt;Logic App kopierar filen till test&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="273" width="146" height="34" as="geometry"/></mxCell><mxCell id="s2_b" value="Triggas när en fil skapas eller ändras, skriver status Ny och kopierar den sparade versionen till containern test. Den startar sedan stegen 3 till 5." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="418" y="311" width="184" height="90" as="geometry"/></mxCell><mxCell id="s2_n" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="404" y="259" width="22" height="22" as="geometry"/></mxCell><mxCell id="f" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="650" y="265" width="200" height="140" as="geometry"/></mxCell><mxCell id="f_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/integration/Logic_Apps.svg;" vertex="1" parent="1"><mxGeometry x="660" y="275" width="30" height="30" as="geometry"/></mxCell><mxCell id="f_t" value="&lt;b&gt;Underkänd&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="698" y="273" width="146" height="34" as="geometry"/></mxCell><mxCell id="f_b" value="Status sätts till Underkänd. Logic App skickar felet till användaren i Teams eller mejl. Produktion berörs inte." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="658" y="311" width="184" height="90" as="geometry"/></mxCell><mxCell id="k" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1130" y="265" width="200" height="140" as="geometry"/></mxCell><mxCell id="k_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1140" y="275" width="30" height="30" as="geometry"/></mxCell><mxCell id="k_t" value="&lt;b&gt;Kontrolltabell&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1178" y="273" width="146" height="34" as="geometry"/></mxCell><mxCell id="k_b" value="Varje steg skriver status per fil och version: Ny, Validerad, Testad, Väntar på godkännande, Publicerad eller Underkänd." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1138" y="311" width="184" height="90" as="geometry"/></mxCell><mxCell id="s7" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F2994A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1370" y="265" width="200" height="140" as="geometry"/></mxCell><mxCell id="s7_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/integration/Logic_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1380" y="275" width="30" height="30" as="geometry"/></mxCell><mxCell id="s7_t" value="&lt;b&gt;Begär godkännande och publicerar&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1418" y="273" width="146" height="34" as="geometry"/></mxCell><mxCell id="s7_b" value="Skickar en sammanfattning och en länk till testresultatet till dataägaren, väntar på svar och kopierar filen till prod vid godkännande." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1378" y="311" width="184" height="90" as="geometry"/></mxCell><mxCell id="s7_n" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1364" y="259" width="22" height="22" as="geometry"/></mxCell><mxCell id="ct" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="410" y="445" width="200" height="140" as="geometry"/></mxCell><mxCell id="ct_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="420" y="455" width="30" height="30" as="geometry"/></mxCell><mxCell id="ct_t" value="&lt;b&gt;Container test&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="453" width="146" height="34" as="geometry"/></mxCell><mxCell id="ct_b" value="Storage account referensdata. Versionerad sökväg {dataset}/{version}.xlsx. Läses av testets ADF och Databricks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="418" y="491" width="184" height="90" as="geometry"/></mxCell><mxCell id="cp" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#3C9D3C;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1610" y="445" width="200" height="140" as="geometry"/></mxCell><mxCell id="cp_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1620" y="455" width="30" height="30" as="geometry"/></mxCell><mxCell id="cp_t" value="&lt;b&gt;Container prod&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1658" y="453" width="146" height="34" as="geometry"/></mxCell><mxCell id="cp_b" value="Storage account referensdata. Skrivs bara efter godkännande. Läses av produktionens ADF och Databricks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1618" y="491" width="184" height="90" as="geometry"/></mxCell><mxCell id="s4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="650" y="625" width="200" height="140" as="geometry"/></mxCell><mxCell id="s4_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="660" y="635" width="30" height="30" as="geometry"/></mxCell><mxCell id="s4_t" value="&lt;b&gt;Validera filen&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="698" y="633" width="146" height="34" as="geometry"/></mxCell><mxCell id="s4_b" value="En Azure Function kontrollerar kolumner, datatyper, unika nycklar och tillåtna värden mot datasetets kontrakt. Fel stoppar flödet här." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="658" y="671" width="184" height="90" as="geometry"/></mxCell><mxCell id="s4_n" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="644" y="619" width="22" height="22" as="geometry"/></mxCell><mxCell id="s5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="890" y="625" width="200" height="140" as="geometry"/></mxCell><mxCell id="s5_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/databases/Data_Factory.svg;" vertex="1" parent="1"><mxGeometry x="900" y="635" width="30" height="30" as="geometry"/></mxCell><mxCell id="s5_t" value="&lt;b&gt;Läs in i test_raw&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="938" y="633" width="146" height="34" as="geometry"/></mxCell><mxCell id="s5_b" value="ADF (Azure Data Factory) läser Excel-filen från containern test till tabellen i katalogen test_raw." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="898" y="671" width="184" height="90" as="geometry"/></mxCell><mxCell id="s5_n" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="884" y="619" width="22" height="22" as="geometry"/></mxCell><mxCell id="s6" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1130" y="625" width="200" height="140" as="geometry"/></mxCell><mxCell id="s6_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="1140" y="635" width="30" height="30" as="geometry"/></mxCell><mxCell id="s6_t" value="&lt;b&gt;dbt run och dbt test i test&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1178" y="633" width="146" height="34" as="geometry"/></mxCell><mxCell id="s6_b" value="Ett Databricks-jobb med service principal kör referensdatans modeller, allt som beror på dem och testerna. Fel stoppar flödet här." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1138" y="671" width="184" height="90" as="geometry"/></mxCell><mxCell id="s6_n" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1124" y="619" width="22" height="22" as="geometry"/></mxCell><mxCell id="o" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F2994A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1370" y="805" width="200" height="140" as="geometry"/></mxCell><mxCell id="o_i" value="Ä" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F2994A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1380" y="815" width="30" height="30" as="geometry"/></mxCell><mxCell id="o_t" value="&lt;b&gt;Dataägaren beslutar&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1418" y="813" width="146" height="34" as="geometry"/></mxCell><mxCell id="o_b" value="Godkänner eller avslår. Ett avslag behandlas som Underkänd, med ägarens kommentar till användaren." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1378" y="851" width="184" height="90" as="geometry"/></mxCell><mxCell id="o_n" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1364" y="799" width="22" height="22" as="geometry"/></mxCell><mxCell id="p" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#3C9D3C;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1610" y="985" width="200" height="140" as="geometry"/></mxCell><mxCell id="p_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="1620" y="995" width="30" height="30" as="geometry"/></mxCell><mxCell id="p_t" value="&lt;b&gt;Produktion läser bara prod&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1658" y="993" width="146" height="34" as="geometry"/></mxCell><mxCell id="p_b" value="ADF läser containern prod till prod_raw vid ordinarie körning och dbt bygger modellerna. Senast godkända version gäller tills en ny godkänns." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="1618" y="1031" width="184" height="90" as="geometry"/></mxCell><mxCell id="p_n" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1604" y="979" width="22" height="22" as="geometry"/></mxCell><mxCell id="note" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#98A8B8;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="442" width="440" height="100" as="geometry"/></mxCell><mxCell id="note_t" value="&lt;b&gt;Ett storage account, två containrar&lt;/b&gt;&lt;br&gt;Roller sätts per container. Testets ADF och Databricks läser bara test, produktionens bara prod. Bara Logic Appens identitet skriver, och prod skrivs först efter godkännande. Användare har ingen åtkomst." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="888" y="448" width="424" height="88" as="geometry"/></mxCell><mxCell id="h_steps" value="&lt;b&gt;Förklaring av stegen&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1160" width="920" height="20" as="geometry"/></mxCell><mxCell id="ps1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1190" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst1" value="En användare sparar en Excel-fil i ett SharePoint-bibliotek. Filen påverkar inte produktion." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="46" y="1190" width="414" height="32.16" as="geometry"/></mxCell><mxCell id="ps2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1232.16" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst2" value="En Logic App per bibliotek eller mapp triggas av nya och ändrade filer. Alla byggs från en mall och en konfigurationstabell, så ett nytt bibliotek blir en rad i tabellen och inte en ny pipeline. Logic App skriver status Ny, kopierar den sparade versionen till containern test i storage account referensdata, på en versionerad sökväg med checksumma, och orkestrerar steg 3 till 5." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="46" y="1232.16" width="414" height="88.48" as="geometry"/></mxCell><mxCell id="ps3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1330.64" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst3" value="En Azure Function jämför filen med datasetets kontrakt: förväntade kolumner, datatyper, obligatoriska fält, unika nycklar och tillåtna värden. En fil som bryter kontraktet når aldrig dbt." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="46" y="1330.64" width="414" height="46.24" as="geometry"/></mxCell><mxCell id="ps4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1386.88" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst4" value="ADF läser Excel-filen från containern test till tabellen i test_raw, i testets workspace." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="46" y="1386.88" width="414" height="32.16" as="geometry"/></mxCell><mxCell id="ps5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1429.0400000000002" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst5" value="Ett Databricks-jobb kör dbt run och dbt test i test för referensdatans modeller och allt som beror på dem, med samma kod och releasetagg som produktion." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="46" y="1429.0400000000002" width="414" height="46.24" as="geometry"/></mxCell><mxCell id="ps6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1190" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst6" value="Först när test är grönt skickar Logic App en begäran till dataägaren med en sammanfattning av ändringen och en länk till testresultatet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="506" y="1190" width="414" height="32.16" as="geometry"/></mxCell><mxCell id="ps7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1232.16" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst7" value="Dataägaren godkänner eller avslår. Om filen ändras igen under tiden ersätter den nya versionen den gamla och godkännandet dras tillbaka." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="506" y="1232.16" width="414" height="32.16" as="geometry"/></mxCell><mxCell id="ps8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1274.3200000000002" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst8" value="Vid godkännande kopierar Logic App filen från containern test till containern prod. Checksumman jämförs, så produktion får exakt det som testades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="506" y="1274.3200000000002" width="414" height="46.24" as="geometry"/></mxCell><mxCell id="ps9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3A57;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1330.5600000000002" width="22" height="22" as="geometry"/></mxCell><mxCell id="pst9" value="Produktion läser bara containern prod. ADF läser filen till prod_raw vid ordinarie körning och dbt bygger modellerna. Underkända filer når aldrig hit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="506" y="1330.5600000000002" width="414" height="46.24" as="geometry"/></mxCell><mxCell id="h_rules" value="&lt;b&gt;Designregler&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1160" width="900" height="20" as="geometry"/></mxCell><mxCell id="r1190" value="• Användare skriver aldrig till produktion. Containern prod skrivs bara av Logic Appens identitet, och bara efter godkännande." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1190" width="900" height="18.08" as="geometry"/></mxCell><mxCell id="r1216" value="• Samma fil testas och publiceras. Checksumman avgör att produktion får exakt den version som klarade testet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1216.08" width="900" height="18.08" as="geometry"/></mxCell><mxCell id="r1242" value="• Datafel och plattformsfel skiljs åt. Datafel går till användaren som ändrade filen. Fel i Logic Apps, ADF, Databricks eller nätverk går till BI-teamet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1242.1599999999999" width="900" height="32.16" as="geometry"/></mxCell><mxCell id="r1282" value="• Produktion fortsätter på senast godkända version när en ny fil underkänns, så ett fel i en fil stoppar inte produktions-dbt." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1282.32" width="900" height="18.08" as="geometry"/></mxCell><mxCell id="r1308" value="• Ett dataset har en fil i flödet i taget. Nya versioner köas eller ersätter den som väntar." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1308.3999999999999" width="900" height="18.08" as="geometry"/></mxCell><mxCell id="h_open" value="&lt;b&gt;Öppna punkter att besluta&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1340.4799999999998" width="900" height="20" as="geometry"/></mxCell><mxCell id="o1366" value="• Båda containrarna ligger i samma storage account och därmed i samma subscription. Separationen mellan test och produktion vilar då på rollerna per container och inte på subscription-gränsen. Om kravet är hård separation behövs ett storage account per miljö." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1366.4799999999998" width="900" height="32.16" as="geometry"/></mxCell><mxCell id="o1406" value="• Ett kontrakt per dataset (kolumner, datatyper, nycklar) behöver tas fram tillsammans med dataägarna." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1406.6399999999999" width="900" height="18.08" as="geometry"/></mxCell><mxCell id="o1432" value="• Produktions-dbt plockar upp en godkänd fil vid nästa ordinarie körning. Om referensdatan ska gälla direkt behövs en separat körning av just de modellerna." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1432.7199999999998" width="900" height="32.16" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Referensdata:&lt;/b&gt; ändrade Excel-filer testas i test och godkänns av dataägaren innan de når produktion" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#1F1F1F;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1800" height="36" as="geometry"/></mxCell><mxCell id="legend" value="Blå pil: huvudflöde. Röd streckad pil: fel. Grön pil: godkänd väg till produktion. Orange pil: begäran till dataägaren. Grå streckad pil: återgång. Siffrorna i cirklarna hänvisar till stegen ovan." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1505" width="1860" height="20" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="335"/></Array></mxGeometry></mxCell><mxCell id="e2" value="kopierar filen" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="ct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ct" target="s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="695"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ef1" value="fel" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="s4" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ef2" value="fel" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="s6" target="f"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="578"/><mxPoint x="800" y="578"/></Array></mxGeometry></mxCell><mxCell id="ef3" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="f" target="u"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ef4" value="sparar ny version" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#7A7A7A;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="u" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="grönt" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3C9D3C;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="695"/><mxPoint x="1350" y="335"/></Array></mxGeometry></mxCell><mxCell id="e8" value="begäran" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#F2994A;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s7" target="o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="svar" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3C9D3C;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="8 godkänt: kopierar test till prod" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3C9D3C;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s7" target="cp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="335"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#3C9D3C;strokeWidth=1.7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cp" target="p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>