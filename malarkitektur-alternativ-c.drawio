<mxfile host="app.diagrams.net"><diagram name="Målarkitektur C"><mxGraphModel dx="1900" dy="1080" grid="0" page="1" pageWidth="1900" pageHeight="1060" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Målarkitektur, förslag alternativ C:&lt;/b&gt; två Azure-subscriptions, tre Databricks-workspaces, en Unity Catalog-metastore" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1400" height="35" as="geometry"/></mxCell><mxCell id="entra" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="440" height="120" as="geometry"/></mxCell><mxCell id="entra_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/identity/Entra_Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="52" height="46" as="geometry"/></mxCell><mxCell id="entra_t" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;Grupper på kontonivå för användare&lt;br&gt;Service principals och managed identities" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="100" y="75" width="350" height="100" as="geometry"/></mxCell><mxCell id="meta" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F2994A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="480" y="65" width="520" height="120" as="geometry"/></mxCell><mxCell id="meta_i" value="" style="image;aspect=fixed;html=1;points=[];align=center;image=https://app.diagrams.net/img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="495" y="90" width="42" height="45" as="geome